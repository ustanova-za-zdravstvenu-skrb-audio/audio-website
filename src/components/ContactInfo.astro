---
import kontakt from '../data/kontakt.json';
import { telHref } from '../lib/tel.js';

interface Props { sluzbena?: boolean; }
const { sluzbena = false } = Astro.props;

const phone = '<svg viewBox="0 0 512 512"><path d="M493.4 24.6l-104-24c-11.3-2.6-22.9 3.3-27.5 13.9l-48 112c-4.2 9.8-1.4 21.3 6.9 28l60.6 49.6c-36 76.7-98.9 140.5-177.2 177.2l-49.6-60.6c-6.8-8.3-18.2-11.1-28-6.9l-112 48C3.9 366.5-2 378.1.6 389.4l24 104C27.1 504.2 36.7 512 48 512c256.1 0 464-207.5 464-464 0-11.2-7.7-20.9-18.6-23.4z"/></svg>';
const pin = '<svg viewBox="0 0 384 512"><path d="M172.268 501.67C26.97 291.031 0 269.413 0 192 0 85.961 85.961 0 192 0s192 85.961 192 192c0 77.413-26.97 99.031-172.268 309.67-9.535 13.774-29.93 13.773-39.464 0zM192 272c44.183 0 80-35.817 80-80s-35.817-80-80-80-80 35.817-80 80 35.817 80 80 80z"/></svg>';

const mat = kontakt.lokacije[0];
---
<div class="cinfo reveal">
  {kontakt.lokacije.map((l) => (
    <div class="item">
      <span class="ic" aria-hidden="true" set:html={phone} />
      <div><h4>{l.oznaka}</h4><p>{l.adresa}<br />Tel: <a href={`tel:${telHref(l.telefon)}`}>{l.telefon}</a> · <a href={`mailto:${l.email}`}>{l.email}</a></p></div>
    </div>
  ))}
  <div class="item">
    <span class="ic" aria-hidden="true" set:html={phone} />
    <div><h4>Privatne usluge</h4><p>Tel: <a href={`tel:${telHref(kontakt.privatneUslugeTelefon)}`}>{kontakt.privatneUslugeTelefon}</a></p></div>
  </div>
  {sluzbena && (
    <div class="item">
      <span class="ic" aria-hidden="true" set:html={pin} />
      <div><h4>Službena adresa</h4><p>{kontakt.punNaziv}<br />{mat.adresaPuna}<br />OIB: {kontakt.oib}</p></div>
    </div>
  )}
</div>
