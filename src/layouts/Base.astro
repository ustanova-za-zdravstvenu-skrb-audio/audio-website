---
import obavijest from '../data/obavijest.json';
import kontakt from '../data/kontakt.json';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}
const { title, description = '', noindex = false } = Astro.props;

// tel: href iz prikaznog broja (npr. "01 2305 444" -> "+38512305444")
const telHref = (s: string): string => {
  const d = (s || '').replace(/\D/g, '');
  return d ? '+385' + d.replace(/^0/, '') : '';
};

const [mat, pod] = kontakt.lokacije;

// stabilan ključ za "zatvori obavijest" — mijenja se kad se promijeni tekst,
// pa nova obavijest ponovno iskoči i onima koji su staru zatvorili.
const dismissKey = (() => {
  const s = obavijest?.tekst || '';
  let h = 0;
  for (let i = 0; i < s.length; i++) h = (h * 31 + s.charCodeAt(i)) >>> 0;
  return 'audio-obav-' + h;
})();
---
<!DOCTYPE html>
<html lang="hr">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{title}</title>
{description && <meta name="description" content={description} />}
{noindex && <meta name="robots" content="noindex" />}
<link rel="icon" href="/images/2024/09/cropped-icon-6.png" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..700;1,9..144,400..700&family=Inter:wght@400;600;700&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="/style.css" />
</head>
<body>

{obavijest?.aktivna && (
  <div class="announce" id="announce" role="region" aria-label="Obavijest">
    <div class="container">
      {obavijest.oznaka && <span class="pill">{obavijest.oznaka}</span>}
      <span>
        {obavijest.tekst}
        {obavijest.telefon && (
          <> <a href={`tel:${telHref(obavijest.telefon)}`}>{obavijest.telefon}</a></>
        )}
      </span>
      <button class="close" id="announceClose" aria-label="Zatvori obavijest">&#10005;</button>
    </div>
  </div>
)}

<header class="hd">
  <div class="container">
    <a class="brand" href="/">
      <img src="/images/2024/09/icon-6.png" alt="AUDIO logo" />
      <span><b>Ustanova za zdravstvenu skrb AUDIO</b><small>Zagreb</small></span>
    </a>
    <button class="burger" aria-label="Izbornik" aria-expanded="false" aria-controls="mainNav" type="button"
      onclick="const n=document.getElementById('mainNav');const o=n.classList.toggle('open');this.setAttribute('aria-expanded',o);document.body.classList.toggle('nav-lock',o)">
      <span></span><span></span><span></span>
    </button>
    <nav class="nav" id="mainNav" aria-label="Glavna navigacija">
      <a href="/usluge">Usluge</a>
      <a href="/ordinacije">Ordinacije</a>
      <a href="/novosti">Novosti</a>
      <a href="/tim">Tim</a>
      <a href="/o-nama">O nama</a>
      <a class="cta" href="/#kontakt">Naručite se</a>
      <div class="nav-contact" aria-label="Kontakt">
        <span class="lbl">Nazovite nas</span>
        {kontakt.lokacije.map((l) => (
          <a href={`tel:${telHref(l.telefon)}`}>{l.adresa.split(',')[0]}<small>{l.telefon}</small></a>
        ))}
      </div>
    </nav>
  </div>
</header>

<slot />

<footer class="ft">
  <div class="container ft-top">
    <div class="ft-brand">
      <a class="ft-logo" href="/">
        <img src="/images/2024/09/icon-6.png" alt="" width="42" height="42" />
        <span><b>Ustanova za zdravstvenu skrb AUDIO</b><small>Zagreb</small></span>
      </a>
      <p class="ft-tag">Specijalističke ordinacije obiteljske i dentalne medicine — HZZO ugovorna ustanova, uz privatne dodatne dijagnostičke i specijalističke usluge.</p>
      <nav class="ft-links" aria-label="Podnožje">
        <a href="/usluge">Usluge</a>
        <a href="/ordinacije">Ordinacije</a>
        <a href="/novosti">Novosti</a>
        <a href="/tim">Tim</a>
        <a href="/o-nama">O nama</a>
      </nav>
    </div>
    <div class="ft-loc">
      <h4>{mat.oznaka}</h4>
      <p class="ft-addr">{mat.adresa}</p>
      <p class="ft-line"><a href={`tel:${telHref(mat.telefon)}`}>{mat.telefon}</a> · <a href={`mailto:${mat.email}`}>{mat.email}</a></p>
      <a class="ft-map" href="https://www.google.com/maps/search/?api=1&query=Bo%C5%BEidarevi%C4%87eva%20ulica%207%2C%20Zagreb" target="_blank" rel="noopener" aria-label="Božidarevićeva 7 na Google kartama"><svg viewBox="0 0 300 150" preserveAspectRatio="xMidYMid slice" aria-hidden="true"><defs><linearGradient id="ftm1" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#eef2f3"/><stop offset="1" stop-color="#e3eaec"/></linearGradient></defs><rect width="300" height="150" fill="url(#ftm1)"/><g fill="#d6e4cf" fill-rule="evenodd" opacity=".9"><path d="M272.4 77.1 L279.8 69.3 L282.8 74.0 L282.7 79.6 L274.2 79.9 L272.4 77.1 Z"/><path d="M44.8 160.1 L41.9 151.5 L43.9 149.9 L43.4 148.9 L45.2 148.0 L44.6 146.9 L45.2 146.6 L52.8 142.8 L59.7 139.5 L58.6 137.3 L63.0 135.5 L69.1 133.5 L69.3 133.9 L69.1 137.3 L69.4 138.8 L70.1 139.2 L70.4 139.6 L70.7 140.1 L70.6 140.7 L70.5 141.2 L70.2 141.8 L69.7 142.1 L69.1 142.4 L70.2 145.8 L61.7 148.8 L62.4 151.4 L62.8 152.6 L63.0 153.8 L53.9 157.0 L44.8 160.1 Z"/><path d="M-5.6 110.9 L-0.7 107.7 L2.0 111.6 L-3.0 115.3 L-5.6 110.9 Z"/><path d="M87.6 72.9 L91.6 84.8 L98.5 82.5 L94.6 70.6 L87.6 72.9 Z"/><path d="M91.9 85.4 L94.6 94.1 L99.7 92.5 L97.0 83.8 L91.9 85.4 Z"/><path d="M104.8 -10.3 L106.7 -8.6 L111.5 -4.4 L112.4 -3.4 L113.2 -2.2 L114.7 1.0 L115.7 3.6 L118.0 13.4 L118.5 13.8 L119.0 13.9 L155.4 -5.8 L169.8 -12.5 L188.0 -21.1 L191.2 -22.3 L197.0 -23.9 L197.9 -24.4 L198.6 -25.2 L192.3 -29.3 L186.9 -32.9 L183.6 -34.4 L168.8 -33.9 L158.5 -30.2 L145.3 -20.6 L138.1 -17.6 L134.7 -16.4 L127.2 -13.7 L117.9 -11.3 L106.6 -11.4 L103.9 -11.4 L104.5 -10.1 L104.8 -10.3 Z"/><path d="M97.1 69.8 L100.7 81.0 L106.2 79.2 L102.6 68.1 L97.1 69.8 Z"/><path d="M17.2 137.0 L19.6 137.8 L21.3 138.1 L21.9 138.2 L23.4 138.2 L25.4 137.8 L29.1 135.8 L27.2 129.1 L19.5 132.3 L18.8 133.3 L17.9 135.5 L17.2 137.0 Z"/><path d="M53.0 108.0 L44.6 112.6 L52.1 126.3 L60.7 121.6 L54.8 111.2 L53.0 108.0 Z"/><path d="M52.1 106.4 L53.0 108.0 L54.8 111.2 L64.2 108.3 L62.6 1