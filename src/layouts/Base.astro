    </a>
    <button class="burger" aria-label="Izbornik" aria-expanded="false" aria-controls="mainNav" type="button"
      onclick="const n=document.getElementById('mainNav');const o=n.classList.toggle('open');this.setAttribute('aria-expanded',o);document.body.classList.toggle('nav-lock',o)">
      <span></span><span></span><span></span>
