---
import obavijest from '../data/obavijest.json';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}
const { title, description = '', noindex = false } = Astro.props;

// tel: href iz prikaznog broja (npr. "01 2305 444" -> "+38512305444")
const telHref = (s: string): string => {
  const d = (s || '').replace(/\D/g, '');
  return d ? '+385' + d.replace(/^0/, '') : '';
};

// stabilan ključ za "zatvori obavijest" — mijenja se kad se promijeni tekst,
// pa nova obavijest ponovno iskoči i onima koji su staru zatvorili.
const dismissKey = (() => {
  const s = obavijest?.tekst || '';
  let h = 0;
  for (let i = 0; i < s.length; i++) h = (h * 31 + s.charCodeAt(i)) >>> 0;
  return 'audio-obav-' + h;
})();
---
<!DOCTYPE html>
<html lang="hr">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{title}</title>
{description && <meta name="description" content={description} />}
{noindex && <meta name="robots" content="noindex" />}
<link rel="icon" href="/images/2024/09/cropped-icon-6.png" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..700;1,9..144,400..700&family=Inter:wght@400;600;700&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="/style.css" />
</head>
<body>

{obavijest?.aktivna && (
  <div class="announce" id="announce" role="region" aria-label="Obavijest">
    <div class="container">
      {obavijest.oznaka && <span class="pill">{obavijest.oznaka}</span>}
      <span>
        {obavijest.tekst}
        {obavijest.telefon && (
          <> <a href={`tel:${telHref(obavijest.telefon)}`}>{obavijest.telefon}</a></>
        )}
      </span>
      <button class="close" id="announceClose" aria-label="Zatvori obavijest">&#10005;</button>
    </div>
  </div>
)}

<header class="hd">
  <div class="container">
    <a class="brand" href="/">
      <img src="/images/2024/09/icon-6.png" alt="AUDIO logo" />
      <span><b>Ustanova za zdravstvenu skrb AUDIO</b><small>Zagreb</small></span>
    </a>
    <button class="burger" aria-label="Izbornik" aria-expanded="false" aria-controls="mainNav" type="button"
      onclick="const n=document.getElementById('mainNav');n.classList.toggle('open');this.setAttribute('aria-expanded',n.classList.contains('open'))">
      <span></span><span></span><span></span>
    </button>
    <nav class="nav" id="mainNav" aria-label="Glavna navigacija">
      <a href="/#o-nama">O nama</a>
      <a href="/usluge">Usluge</a>
      <a href="/#radno_vrijeme">Ordinacije</a>
      <a href="/novosti">Novosti</a>
      <a href="/#tim">Tim</a>
      <a class="cta" href="/#kontakt">Naručite se</a>
    </nav>
  </div>
</header>

<slot />

<footer class="ft">
  <div class="container cols">
    <div>
      <h4>Matična ustanova<br />(Božidarevićeva ulica 7, Zagreb)</h4>
      <p><strong>E-mail:</strong> <a href="mailto:doktor@audio.hr">doktor@audio.hr</a></p>
      <p><strong>Telefon:</strong> 01 2314 014</p>
      <iframe loading="lazy" title="Karta — Božidarevićeva ulica 7, Zagreb" src="https://maps.google.com/maps?q=Bo%C5%BEidarevi%C4%87eva%20ulica%207%2C%2010000%20Zagreb&t=&z=15&ie=UTF8&iwloc=&output=embed"></iframe>
    </div>
    <div>
      <h4>Podružnica 1<br />(Ul. Ede Murtića 6, Zagreb)</h4>
      <p><strong>E-mail:</strong> <a href="mailto:ordinacija@audio.hr">ordinacija@audio.hr</a></p>
      <p><strong>Telefon:</strong> 01 6636 677</p>
      <iframe loading="lazy" title="Karta — Ede Murtića 6, Zagreb" src="https://maps.google.com/maps?q=Ede%20Murti%C4%87a%206%2C%2010000%20Zagreb&t=&z=15&ie=UTF8&iwloc=&output=embed"></iframe>
    </div>
    <div>
      <h4>Službeni kontakt</h4>
      <p><strong>Ustanova za zdravstvenu skrb AUDIO</strong></p>
      <p><strong>OIB:</strong> 43175796624</p>
      <p><strong>Službena adresa:</strong> Božidarevićeva ulica 7, 10000 Zagreb</p>
      <p><strong>Za pravne upite:</strong> <a href="mailto:ravnateljstvo@audio.hr">ravnateljstvo@audio.hr</a></p>
    </div>
  </div>
  <div class="container base">
    <span>© <span id="god"></span> Ustanova za zdravstvenu skrb AUDIO. Sva prava pridržana.</span>
    <a href="/pravila-privatnosti">Pravila privatnosti</a>
  </div>
</footer>

<script is:inline define:vars={{ dismissKey }}>
  // Obavijesna traka — zatvaranje + pamćenje
  (function () {
    var a = document.getElementById('announce');
    if (a) {
      try { if (localStorage.getItem(dismissKey) === '1') a.remove(); } catch (e) {}
      var btn = document.getElementById('announceClose');
      if (btn) btn.addEventListener('click', function () {
        a.remove();
        try { localStorage.setItem(dismissKey, '1'); } catch (e) {}
      });
    }
  })();

  // Godina u footeru
  var g = document.getElementById('god');
  if (g) g.textContent = new Date().getFullYear();
</script>

<script is:inline>
  // Reveal-on-scroll (progresivno poboljšanje; bez JS-a / uz reduced-motion sve je odmah vidljivo)
  (function () {
    var els = [].slice.call(document.querySelectorAll('.reveal'));
    if (!els.length) return;
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    if (!('IntersectionObserver' in window) || reduce.matches) {
      els.forEach(function (el) { el.classList.add('in'); });
      return;
    }
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
      });
    }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
    els.forEach(function (el) { io.observe(el); });
  })();

  // Brojači
  (function () {
    var nums = [].slice.call(document.querySelectorAll('[data-count]'));
    if (!nums.length) return;
    var co = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (!e.isIntersecting) return;
        var el = e.target, t = +el.dataset.count, dur = 1500, t0 = performance.now();
        (function tick(now) {
          var p = Math.min((now - t0) / dur, 1);
          el.textContent = Math.round(t * (1 - Math.pow(1 - p, 3))).toLocaleString('hr-HR');
          if (p < 1) requestAnimationFrame(tick);
        })(t0);
        co.unobserve(el);
      });
    }, { threshold: 0.5 });
    nums.forEach(function (el) { co.observe(el); });
  })();

  // Kontakt forma -> FormSubmit (AJAX)
  (function () {
    var form = document.getElementById('kontaktForma');
    if (!form) return;
    var ENDPOINT = 'https://formsubmit.co/ajax/rokogrguric@gmail.com'; // TEST inbox; prije launcha -> ordinacija@audio.hr
    var statusEl = document.getElementById('formStatus');
    var btn = form.querySelector('button[type="submit"]');
    function setStatus(msg, cls) { if (statusEl) { statusEl.textContent = msg; statusEl.className = 'form-status' + (cls ? ' ' + cls : ''); } }
    form.addEventListener('submit', function (ev) {
      ev.preventDefault();
      var hp = form.querySelector('[name="_honey"]');
      if (hp && hp.value) return;
      var f = new FormData(form);
      var vrsta = f.get('vrsta') || '';
      f.append('_subject', 'Upit s web stranice — ' + vrsta);
      f.append('_template', 'table');
      f.set('_captcha', 'false');
      if (btn) { btn.disabled = true; btn.textContent = 'Šaljem…'; }
      setStatus('', '');
      fetch(ENDPOINT, { method: 'POST', body: f, headers: { 'Accept': 'application/json' } })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          if (data && (data.success === 'true' || data.success === true)) {
            form.reset();
            setStatus('Hvala! Vaša poruka je poslana — javit ćemo se u najkraćem roku.', 'ok');
          } else { throw new Error('fail'); }
        })
        .catch(function () {
          setStatus('Slanje trenutačno nije uspjelo. Nazovite nas ili pokušajte ponovno.', 'err');
        })
        .finally(function () { if (btn) { btn.disabled = false; btn.textContent = 'Pošalji'; } });
    });
  })();

  // Zatvori mobilni izbornik nakon klika na link ili na resize
  (function () {
    var nav = document.getElementById('mainNav');
    if (!nav) return;
    var burger = document.querySelector('.burger');
    function close() {
      nav.classList.remove('open');
      if (burger) burger.setAttribute('aria-expanded', 'false');
    }
    nav.querySelectorAll('a').forEach(function (a) { a.addEventListener('click', close); });
    window.addEventListener('resize', function () { if (window.innerWidth > 740) close(); });
  })();
</script>
</body>
</html>
