---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { formatDate as fmt } from '../lib/date';
import usluge from '../data/usluge.json';
import ContactInfo from '../components/ContactInfo.astro';

const stavke = usluge.stavke ?? [];

const heroSlides = [
  { naslov: 'Privatna obiteljska medicina', podnaslov: 'Osobna, dostupna i kontinuirana zdravstvena skrb.', slika: '/images/hero/obiteljska-medicina.jpg', link: '/usluge' },
  { naslov: 'Unapređenje zdravlja uz Mounjaro', podnaslov: 'Medicinski vođen program regulacije tjelesne težine i metaboličkog zdravlja.', slika: '/images/hero/mounjaro.jpg', link: '/usluge' },
  { naslov: 'Specijalističke ambulante – sve na jednom mjestu', podnaslov: 'Specijalistički pregledi, dijagnostika i koordinirana zdravstvena skrb.', slika: '/images/hero/specijalisticke-ambulante.jpg', link: '/usluge', mobPos: '70%' },
  { naslov: 'Ultrazvučna dijagnostika', podnaslov: 'Suvremena ultrazvučna dijagnostika uz individualni pristup.', slika: '/images/hero/ultrazvucna-dijagnostika.jpg', link: '/usluge' },
  { naslov: 'Pregled i liječenje kožnih promjena', podnaslov: 'Pregled, dijagnostika i liječenje madeža i drugih kožnih promjena, od preventivnih pregleda do odgovarajućeg liječenja.', slika: '/images/hero/kozne-promjene.jpg', link: '/usluge' },
  { naslov: 'Terapija bolnih stanja i akupunktura', podnaslov: 'Individualni pristup liječenju akutnih i kroničnih bolnih stanja uz akupunkturu i druge terapijske metode.', slika: '/images/hero/akupunktura.jpg', link: '/usluge' },
];

const latest = (await getCollection('novosti'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
---
<Base
  title={'Ustanova za zdravstvenu skrb AUDIO — slušamo vaše zdravlje'}
  description={'Ustanova za zdravstvenu skrb AUDIO — specijalističke ordinacije obiteljske medicine u Zagrebu. HZZO ugovorna ustanova uz privatne dijagnostičke i specijalističke usluge.'}
>
<main id="home">

<!-- ============ HERO SLIDER ============ -->
<section class="hero-slider" aria-roledescription="carousel" aria-label="Naše usluge">
  <h1 class="sr-only">Ustanova za zdravstvenu skrb AUDIO — privatna obiteljska medicina u Zagrebu</h1>
  {heroSlides.map((s, i) => (
    <div class={i === 0 ? 'hs-slide active' : 'hs-slide'} aria-hidden={i !== 0}>
      <div class="hs-bg" style={`background-image:url(${s.slika});--mob-pos:${s.mobPos || 'right'}`}></div>
      <div class="hs-overlay"></div>
      <div class="container hs-content">
        <div class="hs-text">
          <h2 class="hs-title">{s.naslov}</h2>
          <p class="hs-sub">{s.podnaslov}</p>
          <div class="hs-actions">
            <a class="cta" href={s.link}>Saznajte više</a>
            <a class="cta ghost" href="/#kontakt">Naručite se</a>
          </div>
        </div>
      </div>
    </div>
  ))}
  <button class="hs-arrow hs-prev" type="button" aria-label="Prethodni sadržaj">&#8249;</button>
  <button class="hs-arrow hs-next" type="button" aria-label="Sljedeći sadržaj">&#8250;</button>
  <div class="hs-bar container">
    <div class="hs-dots">
      {heroSlides.map((s, i) => (
        <button class={i === 0 ? 'hs-dot active' : 'hs-dot'} type="button" aria-label={`Prikaži: ${s.naslov}`}></button>
      ))}
    </div>
  </div>
</section>


<!-- ============ USLUGE ============ -->
<section class="svc" id="usluge" aria-labelledby="usl-h">
  <div class="container">
    <div class="svc-grid">
      <div class="svc-copy" id="hzzo">
        <p class="eyebrow reveal" style="color:#a9c4c1">Naše usluge</p>
        <h2 class="t reveal" id="usl-h">Primarna zdravstvena zaštita + <em>specijalističke usluge</em></h2>
        <p class="reveal d1" style="margin-top:24px"><strong>Nudimo cjelokupan program primarne zdravstvene zaštite uz dodatne specijalističke usluge.</strong></p>
        <p class="reveal d2">Dodatno, <strong>dio našeg programa (primarni) je pod pokroviteljstvom HZZO-a</strong>, a dio odrađujemo u privatnom aranžmanu (uz suradnju s brojnim/različitim partnerima).</p>
        <a class="cta reveal d3" href="/usluge">Detaljnije o našim uslugama</a>
      </div>
      <ul class="svc-list">
        {stavke.map((s: { naslov: string; opis?: string }, i: number) => (
          <li class="reveal">
            <span class="no">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3>{s.naslov}</h3>
              {s.opis && <p>{s.opis}</p>}
            </div>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<!-- ============ ZAŠTO AUDIO ============ -->
<section class="why" aria-labelledby="why-h">
  <div class="container">
    <div class="sec-head">
      <div>
        <p class="eyebrow reveal">Naše kvalitete</p>
        <h2 class="t reveal" id="why-h">Zašto odabrati <em>Ustanovu za zdravstvenu skrb AUDIO?</em></h2>
      </div>
      <div class="right reveal d1">
        <p><strong>Ustanova za zdravstvenu skrb AUDIO je ugovorna ustanova Hrvatskog zavoda za zdravstveno osiguranje (HZZO)</strong> koja pruža usluge obiteljske medicine od svojeg osnivanja, 1994. godine.</p>
        <p style="margin-top:12px"><strong>Trenutno usluge obiteljske medicine pružamo kroz tri ordinacije, smještene na dvije lokacije (Božidarevićeva 7 i Ul. Ede Murtića 6)</strong>, a s ciljem osiguravanja najkvalitetnije skrbi i holističkog pristupa svakom pacijentu te s naglaskom na trajno unaprjeđenje dostupnosti, ishoda liječenja i zadovoljstvo pacijenta.</p>
      </div>
    </div>
    <div class="why-grid">
      <div class="wcard reveal">
        <div class="ic" aria-hidden="true"><svg viewBox="0 0 512 512"><path d="M462.3 62.6C407.5 15.9 326 24.3 275.7 76.2L256 96.5l-19.7-20.3C186.1 24.3 104.5 15.9 49.7 62.6c-62.8 53.6-66.1 149.8-9.9 207.9l193.5 199.8c12.5 12.9 32.8 12.9 45.3 0l193.5-199.8c56.3-58.1 53-154.3-9.8-207.9z"/></svg></div>
        <h3>Briga za pacijente</h3><p>Naša misija i vizija su pružanje kvalitetne zdravstvene usluge uz profesionalno osoblje puno razumijevanja i brige za pacijente.</p>
      </div>
      <div class="wcard reveal d1">
        <div class="ic" aria-hidden="true"><svg viewBox="0 0 448 512"><path d="M319.4 320.6L224 416l-95.4-95.4C57.1 323.7 0 382.2 0 454.4v9.6c0 26.5 21.5 48 48 48h352c26.5 0 48-21.5 48-48v-9.6c0-72.2-57.1-130.7-128.6-133.8zM13.6 79.8l6.4 1.5v58.4c-7 4.2-12 11.5-12 20.3 0 8.4 4.6 15.4 11.1 19.7L3.5 242c-1.7 6.9 2.1 14 7.6 14h41.8c5.5 0 9.3-7.1 7.6-14l-15.6-62.3C51.4 175.4 56 168.4 56 160c0-8.8-5-16.1-12-20.3V87.1l66 15.9c-8.6 17.2-14 36.4-14 57 0 70.7 57.3 128 128 128s128-57.3 128-128c0-20.6-5.3-39.8-14-57l96.3-23.2c18.2-4.4 18.2-27.1 0-31.5l-190.4-46c-13-3.1-26.7-3.1-39.7 0L13.6 48.2c-18.1 4.4-18.1 27.2 0 31.6z"/></svg></div>
        <h3>Iskusni stručnjaci</h3><p>Naš tim čine visoko kvalificirani liječnici s dugogodišnjim iskustvom u pružanju primarne zdravstvene skrbi i specijalističkih pregleda.</p>
      </div>
      <div class="wcard reveal d2">
        <div class="ic" aria-hidden="true"><svg viewBox="0 0 512 512"><path d="M320.2 243.8l-49.7 99.4c-6 12.1-23.4 11.7-28.9-.6l-56.9-126.3-30 71.7H60.6l182.5 186.5c7.1 7.3 18.6 7.3 25.7 0L451.4 288H342.3l-22.1-44.2zM473.7 73.9l-2.4-2.5c-51.5-52.6-135.8-52.6-187.4 0L256 100l-27.9-28.5c-51.5-52.7-135.9-52.7-187.4 0l-2.4 2.4C-10.4 123.7-12.5 203 31 256h102.4l35.9-86.2c5.4-12.9 23.6-13.2 29.4-.4l58.2 129.3 49-97.9c5.9-11.8 22.7-11.8 28.6 0l27.6 55.2H481c43.5-53 41.4-132.3-7.3-182.1z"/></svg></div>
        <h3>Moderan dijagnostički centar</h3><p>S našim naprednim dijagnostičkim uređajima, kao što su EKG, Holter tlaka i UZV, možemo brzo i precizno dijagnosticirati te pratiti zdravlje naših pacijenata.</p>
      </div>
      <div class="wcard reveal d2">
        <div class="ic" aria-hidden="true"><svg viewBox="0 0 384 512"><path d="M172.268 501.67C26.97 291.031 0 269.413 0 192 0 85.961 85.961 0 192 0s192 85.961 192 192c0 77.413-26.97 99.031-172.268 309.67-9.535 13.774-29.93 13.773-39.464 0zM192 272c44.183 0 80-35.817 80-80s-35.817-80-80-80-80 35.817-80 80 35.817 80 80 80z"/></svg></div>
        <h3>Pristupačna lokacija</h3><p>Naša glavna lokacija u Zagrebu, u Božidarevićevoj ulici 7, je lako dostupna za sve pacijente. Dodatno, imamo i podružnicu na adresi Ede Murtića 6, Zagreb.</p>
      </div>
    </div>

    <div class="partners reveal">
      <p class="lbl">Naši partneri su:</p>
      <div class="partners-row">
        <a class="partner" href="https://www.pausekdental.hr/" target="_blank" rel="noopener">
          <span class="ic" aria-hidden="true"><svg viewBox="0 0 448 512"><path d="M443.98 96.25c-11.01-45.22-47.11-82.06-92.01-93.72-32.19-8.36-63 5.1-89.14 24.33-3.25 2.39-6.96 3.73-10.5 5.48l28.32 18.21c7.42 4.77 9.58 14.67 4.8 22.11-4.46 6.95-14.27 9.86-22.11 4.8L162.83 12.84c-20.7-10.85-43.38-16.4-66.81-10.31-44.9 11.67-81 48.5-92.01 93.72-10.13 41.62-.42 80.81 21.5 110.43 23.36 31.57 32.68 68.66 36.29 107.35 4.4 47.16 10.33 94.16 20.94 140.32l7.8 33.95c3.19 13.87 15.49 23.7 29.67 23.7 13.97 0 26.15-9.55 29.54-23.16l34.47-138.42c4.56-18.32 20.96-31.16 39.76-31.16s35.2 12.85 39.76 31.16l34.47 138.42c3.39 13.61 15.57 23.16 29.54 23.16 14.18 0 26.48-9.83 29.67-23.7l7.8-33.95c10.61-46.15 16.53-93.16 20.94-140.32 3.61-38.7 12.93-75.78 36.29-107.35 21.95-29.61 31.66-68.8 21.53-110.43z"/></svg></span>
          <span>Privatna ugovorna ordinacija dentalne medicine Đurđica Paušek dr.med.dent<small>pausekdental.hr</small></span>
        </a>
        <a class="partner" href="https://www.poliklinikavm.hr/" target="_blank" rel="noopener">
          <span class="ic" aria-hidden="true"><svg viewBox="0 0 576 512"><path d="M288 115L69.47 307.71c-1.62 1.46-3.69 2.14-5.47 3.35V496a16 16 0 0 0 16 16h416a16 16 0 0 0 16-16V311.1c-1.7-1.16-3.72-1.82-5.26-3.2zm96 261a8 8 0 0 1-8 8h-56v56a8 8 0 0 1-8 8h-48a8 8 0 0 1-8-8v-56h-56a8 8 0 0 1-8-8v-48a8 8 0 0 1 8-8h56v-56a8 8 0 0 1 8-8h48a8 8 0 0 1 8 8v56h56a8 8 0 0 1 8 8zm186.69-139.72l-255.94-226a39.85 39.85 0 0 0-53.45 0l-256 226a16 16 0 0 0-1.21 22.6L25.5 282.7a16 16 0 0 0 22.6 1.21L277.42 81.63a16 16 0 0 1 21.17 0L527.91 283.9a16 16 0 0 0 22.6-1.21l21.4-23.82a16 16 0 0 0-1.22-22.59z"/></svg></span>
          <span>Poliklinika Vallis Medica<small>poliklinikavm.hr</small></span>
        </a>
      </div>
    </div>
  </div>
</section>


{latest.length > 0 && (
  <section id="novosti" class="news-home" aria-labelledby="nov-h">
    <div class="container">
      <div class="sec-head">
        <div>
          <p class="eyebrow reveal">Novosti</p>
          <h2 class="t reveal" id="nov-h">Najnovije <em>iz naše ustanove</em></h2>
        </div>
        <p class="right reveal d1"><a class="cta ghost" href="/novosti">Sve novosti →</a></p>
      </div>
      <div class="news-grid reveal">
        {latest.map((item) => (
          <article class="ncard">
            {item.data.coverImage && (
              <a class="nthumb" href={`/novosti/${item.id}`}>
                <img src={item.data.coverImage} alt={item.data.title} loading="lazy" />
              </a>
            )}
            <div class="nbody">
              <p class="ndate">{fmt(item.data.date)}</p>
              <h3><a href={`/novosti/${item.id}`}>{item.data.title}</a></h3>
              {item.data.summary && <p>{item.data.summary}</p>}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
)}

<!-- ============ STATS ============ -->
<section class="stats" aria-label="Brojke">
  <div class="stats-band">
    <div class="stat reveal"><div class="n"><span data-count="6000">0</span><em>+</em></div><p>Zadovoljnih pacijenata</p></div>
    <div class="stat reveal d1"><div class="n"><span data-count="6">0</span></div><p>Liječnika</p></div>
    <div class="stat reveal d2"><div class="n"><span data-count="1994">0</span><em>. g.</em></div><p>Otvoreni smo od</p></div>
  </div>
</section>

<!-- ============ KONTAKT ============ -->
<section id="kontakt" aria-labelledby="kont-h">
  <div class="container">
    <div class="sec-head">
      <div>
        <p class="eyebrow reveal">Kontakt</p>
        <h2 class="t reveal" id="kont-h">Kontaktirajte nas <em>ili se naručite</em></h2>
      </div>
      <p class="right reveal d1">Imate li pitanje ili vas zanimaju detaljnije informacije o našem radu i uslugama? Ili se jednostavno želite naručiti?</p>
    </div>
    <div class="contact-grid">
      <ContactInfo sluzbena />
      <form class="form reveal d1" id="kontaktForma">
        <input type="text" name="_honey" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <label for="ime">Ime i prezime</label>
        <input type="text" id="ime" name="ime" placeholder="Ime i prezime" required autocomplete="name" />
        <label for="email">E-mail adresa</label>
        <input type="email" id="email" name="email" placeholder="E-mail adresa" autocomplete="email" />
        <label for="vrsta">Vrsta upita</label>
        <select id="vrsta" name="vrsta" required>
          <option value="">- Označite vrstu upita -</option>
          <option>Upit za Matičnu ustanovu (Božidarevićeva ulica 7, Zagreb)</option>
          <option>Upit za Podružnicu 1 (Ede Murtića 6, Zagreb)</option>
          <option>Generalni upit</option>
        </select>
        <label id="hzzo-lbl">HZZO usluga</label>
        <div class="radio-row" role="radiogroup" aria-labelledby="hzzo-lbl">
          <label><input type="radio" name="hzzo" value="Da" /> Da</label>
          <label><input type="radio" name="hzzo" value="Ne" /> Ne</label>
        </div>
        <label for="poruka">Vaša poruka</label>
        <textarea id="poruka" name="poruka" required></textarea>
        <button type="submit">Pošalji</button>
        <p class="form-status" id="formStatus" role="status" aria-live="polite"></p>
        <p class="note">Slanjem prihvaćate obradu podataka radi odgovora na upit sukladno <a href="/pravila-privatnosti">Pravilima privatnosti</a>. Molimo ne šaljite osjetljive zdravstvene podatke putem obrasca.</p>
      </form>
    </div>
  </div>
</section>

</main>

<script is:inline>
  (function () {
    var slider = document.querySelector('.hero-slider');
    if (!slider) return;
    var slides = [].slice.call(slider.querySelectorAll('.hs-slide'));
    var dots = [].slice.call(slider.querySelectorAll('.hs-dot'));
    if (slides.length < 2) return;
    var i = 0, timer = null, DUR = 5000;
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    function show(n) {
      i = (n + slides.length) % slides.length;
      slides.forEach(function (s, k) { s.classList.toggle('active', k === i); s.setAttribute('aria-hidden', k === i ? 'false' : 'true'); });
      dots.forEach(function (d, k) { d.classList.toggle('active', k === i); });
    }
    function stop() { if (timer) { clearInterval(timer); timer = null; } }
    function start() { if (reduce) return; stop(); timer = setInterval(function () { show(i + 1); }, DUR); }
    slider.querySelector('.hs-next').addEventListener('click', function () { show(i + 1); start(); });
    slider.querySelector('.hs-prev').addEventListener('click', function () { show(i - 1); start(); });
    dots.forEach(function (d, k) { d.addEventListener('click', function () { show(k); start(); }); });
    slider.addEventListener('mouseenter', stop);
    slider.addEventListener('mouseleave', start);
    start();
  })();
</script>
</Base>
