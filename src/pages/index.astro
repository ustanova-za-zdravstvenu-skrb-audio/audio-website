---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { formatDate as fmt } from '../lib/date';
import tim from '../data/tim.json';
import usluge from '../data/usluge.json';

const clanovi = tim.clanovi ?? [];
const stavke = usluge.stavke ?? [];

const inicijali = (ime: string): string =>
  (ime || '')
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((w) => Array.from(w)[0] || '')
    .join('')
    .toUpperCase();

const latest = (await getCollection('novosti'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
---
