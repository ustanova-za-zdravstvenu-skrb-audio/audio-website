---
import Base from '../layouts/Base.astro';
import ContactInfo from '../components/ContactInfo.astro';
import hzzo from '../data/usluge-hzzo.json';
import ikone from '../data/hzzo-ikone.json';
import { paras } from '../lib/richtext.js';

---
<Base
  title={'Naše usluge — Ustanova za zdravstvenu skrb AUDIO'}
  description={'HZZO i privatne usluge Ustanove za zdravstvenu skrb AUDIO — pregledi, recepti i uputnice, laboratorijski nalazi, cijepljenja, bolovanja, pomagala i sanitetski prijevoz.'}
>

<div class="page-hero ph-usluge">
  <div class="container">
    <p class="crumb"><a href="/">Naslovnica</a> / Usluge</p>
    <h1>Naše usluge</h1>
    <div class="actions">
      <a class="cta" href="#hzzo">HZZO usluge</a>
      <a class="cta ghost" href="#privatne">Privatne usluge</a>
    </div>
  </div>
</div>

<!-- INTRO -->
<section style="padding-bottom:32px">
  <div class="container">
    <p class="eyebrow reveal">Naše usluge</p>
    <div class="lead-copy reveal d1">
      <p>Ustanova za zdravstvenu skrb AUDIO je <strong>ugovorna ustanova Hrvatskog zavoda za zdravstveno osiguranje (HZZO)</strong> koja pruža usluge obiteljske medicine kroz tri ordinacije obiteljske medicine, smještene na dvije lokacije (Božidarevićeva 7 i Ede Murtića 6).</p>
      <p><strong>Dio naših usluga je pokriven putem HZZO-a, a dio usluga nudimo u privatnom aranžmanu.</strong></p>
      <p>Za sve naše usluge potrebno je unaprijed se naručiti telefonski ili putem e-maila (svi naši kontakti su <a href="/ordinacije">ovdje</a>). U najkraćem mogućem roku odgovaramo na vaše zahtjeve i upite upućene na elektroničku poštu ordinacije.</p>
    </div>
  </div>
</section>

<!-- HZZO USLUGE -->
<section id="hzzo" class="why" aria-labelledby="hzzo-h">
  <div class="container">
    <div class="sec-head">
      <div>
        <p class="eyebrow reveal">Naše HZZO usluge</p>
        <h2 class="t reveal" id="hzzo-h">Što pokrivamo <em>putem HZZO-a?</em></h2>
      </div>
    </div>
    <div class="svc-acc-list">
      {hzzo.usluge.map((u, i) => (
        <details class="svc-acc reveal" open={i === 0}>
          <summary><span class="ic" aria-hidden="true" set:html={ikone[u.ikona]} /><span>{u.naslov}</span></summary>
          <div class="svc-acc-body">{paras(u.sadrzaj).map((p) => <p set:html={p} />)}</div>
        </details>
      ))}
    </div>
  </div>
</section>

<!-- PRIVATNE USLUGE -->
<section class="priv" id="privatne" aria-labelledby="priv-h">
  <div class="container">
    <div class="sec-head">
      <div>
        <p class="eyebrow reveal">Naše privatne usluge</p>
        <h2 class="t reveal" id="priv-h">Vi ste u potpunoj kontroli <em>s privatnim liječnikom</em></h2>
      </div>
      <div class="right reveal d1">
        <p>Kao privatna ordinacija obiteljske medicine ponosimo se našom predanošću i visokom kvalitetom usluge, što se očituje u svemu što radimo – od prvog kontakta, preko dijagnostičkog procesa, pa sve do individualno prilagođenih planova liječenja.</p>
      </div>
    </div>
    <div class="priv-grid">
      <div class="pcard reveal"><span class="no">— 01</span><h3>Pristup usmjeren klijentu</h3><p>Odlični iskusni doktori, u ugodnom okruženju čiji je cilj vaše što brže ozdravljenje i što bezbrižniji tijek liječenja.</p></div>
      <div class="pcard reveal d1"><span class="no">— 02</span><h3>Fleksibilno radno vrijeme</h3><p>Radno vrijeme prilagođeno vama i vašim potrebama.</p></div>
      <div class="pcard reveal d2"><span class="no">— 03</span><h3>Dodatne usluge</h3><p>Nudimo ultrazvučne preglede, EKG, holter tlaka, fizikalnu terapiju (laser, tens) i vađenje krvi te mogućnost obavljanja svega u istome danu.</p></div>
      <div class="pcard reveal"><span class="no">— 04</span><h3>Dodatne konzultacije</h3><p>Savjetovanje s najboljim specijalistima ukoliko je potrebna dodatna konzultacija.</p></div>
      <div class="pcard reveal d1"><span class="no">— 05</span><h3>Sistematski pregledi</h3><p>Individualizirani sistematski pregledi prilagođeni vašim potrebama.</p></div>
      <div class="pcard reveal d2"><span class="no">— 06</span><h3>Sve na jednom mjestu</h3><p>Pregledi, upućivanje specijalistima, utvrđivanje radne nesposobnosti te propisivanje lijekova i pomagala, sve na jednom mjestu.</p></div>
    </div>
  </div>
</section>

<!-- FAQ -->
<section id="faq" class="why" aria-labelledby="faq-h">
  <div class="container">
    <div class="sec-head">
      <div>
        <p class="eyebrow reveal">FAQ</p>
        <h2 class="t reveal" id="faq-h">Što nas <em>najčešće pitaju?</em></h2>
      </div>
      <p class="right reveal d1">Pogledajte listu pitanja s kojima se često susretnemo. Možda ćete u njima pronaći odgovor i prije nego nas kontaktirate.</p>
    </div>
    <div class="faq-wrap reveal">
      <img src="/images/2024/09/medical-563427_1280-1024x682.jpg" alt="Medicinska oprema" loading="lazy" />
      <div class="faq-list">
        {hzzo.faq.map((f, i) => (
          <details class="faq" open={i === 0}>
            <summary>{f.pitanje}</summary>
            <div class="answer">{f.odgovor}</div>
          </details>
        ))}
      </div>
    </div>
  </div>
</section>

<!-- KONTAKT -->
<section id="kontakt" aria-labelledby="kont-h">
  <div class="container">
    <div class="sec-head">
      <div>
        <p class="eyebrow reveal">Kontakt</p>
        <h2 class="t reveal" id="kont-h">Naručite se ili nas <em>pitajte što vas zanima</em></h2>
      </div>
      <p class="right reveal d1">Imate li pitanje ili vas zanimaju detaljnije informacije o našem radu i uslugama? Ili se jednostavno želite naručiti? Sve možete napraviti preko obrasca ispod.</p>
    </div>
    <div class="contact-grid">
      <ContactInfo />
      <form class="form reveal d1" id="kontaktForma">
        <input type="text" name="_honey" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <label for="ime">Ime i prezime</label>
        <input type="text" id="ime" name="ime" placeholder="Ime i prezime" required autocomplete="name" />
        <label for="email">E-mail adresa</label>
        <input type="email" id="email" name="email" placeholder="E-mail adresa" autocomplete="email" />
        <label for="vrsta">Vrsta upita</label>
        <select id="vrsta" name="vrsta" required>
          <option value="">- Označite vrstu upita -</option>
          <option>Upit za Matičnu ustanovu (Božidarevićeva ulica 7, Zagreb)</option>
          <option>Upit za Podružnicu 1 (Ede Murtića 6, Zagreb)</option>
          <option>Generalni upit</option>
        </select>
        <label id="hzzo-lbl">HZZO usluga</label>
        <div class="radio-row" role="radiogroup" aria-labelledby="hzzo-lbl">
          <label><input type="radio" name="hzzo" value="Da" /> Da</label>
          <label><input type="radio" name="hzzo" value="Ne" /> Ne</label>
        </div>
        <label for="poruka">Vaša poruka</label>
        <textarea id="poruka" name="poruka" required></textarea>
        <button type="submit">Pošalji</button>
        <p class="form-status" id="formStatus" role="status" aria-live="polite"></p>
        <p class="note">Slanjem prihvaćate obradu podataka radi odgovora na upit sukladno <a href="/pravila-privatnosti">Pravilima privatnosti</a>. Molimo ne šaljite osjetljive zdravstvene podatke putem obrasca.</p>
      </form>
    </div>
  </div>
</section>

</Base>
