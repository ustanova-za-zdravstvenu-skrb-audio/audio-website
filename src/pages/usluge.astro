<section id="faq" class="why" aria-labelledby="faq-h">
  <div class="container">
    <div class="sec-head">
      <div>
        <p class="eyebrow reveal">FAQ</p>
        <h2 class="t reveal" id="faq-h">Što nas <em>najčešće pitaju?</em></h2>
      </div>
      <p class="right reveal d1">Pogledajte listu pitanja s kojima se često susretnemo. Možda ćete u njima pronaći odgovor i prije nego nas kontaktirate.</p>
    </div>
    <div class="faq-wrap reveal">
      <img src="/images/2024/09/medical-563427_1280-1024x682.jpg" alt="Medicinska oprema" loading="lazy" />
      <div class="faq-list">
        {faq.map((f, i) => (
          <details class="faq" open={i === 0}>
            <summary>{f.q}</summary>
            <div class="answer">{f.a}</div>
          </details>
        ))}
      </div>
    </div>
  </div>
</section>

